<launch>
  <!-- LIO-SAM offline: gleiche Parameter wie live (slam_lio_sam.launch), Eingang aus rosbag play -->
  <rosparam file="/home/nvidia/UNGENAU-LIDAR/ros/config/lio_sam_params.yaml" command="load"/>
  <param name="lio_sam/imuTopic" value="/replay/imu"/>
  <param name="lio_sam/pointCloudTopic" value="/replay/points"/>

  <node pkg="lio_sam" type="lio_sam_imuPreintegration" name="lio_sam_imuPreintegration" output="screen"/>
  <node pkg="lio_sam" type="lio_sam_imageProjection"   name="lio_sam_imageProjection"   output="screen"/>
  <node pkg="lio_sam" type="lio_sam_featureExtraction" name="lio_sam_featureExtraction" output="screen"/>
  <node pkg="lio_sam" type="lio_sam_mapOptmization"    name="lio_sam_mapOptmization"    output="screen"/>

  <param name="robot_description" textfile="/home/nvidia/UNGENAU-LIDAR/ros/robot.urdf"/>
  <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher"/>
</launch>
