<launch>
  <!-- SBG Ellipse 2: offizieller sbg_driver mit use_enu:true + ros_standard:true
       publisht /imu/data direkt mit EKF-Quaternion (ENU) -->
  <!-- sbg_driver wird via start_lidar.sh gestartet, hier nicht nochmal launchen -->

  <!-- LIO-SAM Parameter -->
  <rosparam file="$(find lio_sam)/config/params.yaml" command="load"/>
  <param name="lio_sam/imuTopic" value="/imu/data"/>

  <!-- LIO-SAM Nodes -->
  <node pkg="lio_sam" type="lio_sam_imuPreintegration"  name="lio_sam_imuPreintegration"  output="screen" respawn="true"/>
  <node pkg="lio_sam" type="lio_sam_imageProjection"    name="lio_sam_imageProjection"    output="screen" respawn="true"/>
  <node pkg="lio_sam" type="lio_sam_featureExtraction"  name="lio_sam_featureExtraction"  output="screen" respawn="true"/>
  <node pkg="lio_sam" type="lio_sam_mapOptmization"     name="lio_sam_mapOptmization"     output="screen" respawn="true"/>

  <!-- TF -->
  <param name="robot_description" textfile="/home/nvidia/robot.urdf"/>
  <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" output="screen" respawn="true"/>
</launch>
