<launch>
  <!-- Stufe 1 SLAM-Testprotokoll: FAST-LIO2 mit Ouster-interner IMU statt SBG.
       Isoliert ob Scan-Überlagerung an der SBG-Anbindung liegt oder nicht.
       Siehe docs/slam-staged-testing.md -->

  <rosparam command="load" file="/home/nvidia/UNGENAU-LIDAR/ros/config/fast_lio_ouster_imu.yaml"/>

  <param name="feature_extract_enable" type="bool"   value="0"/>
  <param name="point_filter_num"        type="int"    value="6"/>  <!-- 2048x10: jeder 6. Punkt = gleiche Last wie 1024x10 mit 3 -->
  <param name="max_iteration"           type="int"    value="3"/>
  <param name="filter_size_surf"        type="double" value="0.2"/>
  <param name="filter_size_map"         type="double" value="0.2"/>
  <param name="cube_side_length"        type="double" value="200"/>
  <param name="runtime_pos_log_enable"  type="bool"   value="0"/>

  <node pkg="fast_lio" type="fastlio_mapping" name="laserMapping"
        output="screen" respawn="true"/>

  <!-- TF -->
  <param name="robot_description" textfile="/home/nvidia/UNGENAU-LIDAR/ros/robot.urdf"/>
  <node pkg="robot_state_publisher" type="robot_state_publisher"
        name="robot_state_publisher" output="screen" respawn="true"/>
</launch>
